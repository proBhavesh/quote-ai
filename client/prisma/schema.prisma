generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String          @id @default(cuid())
  name                   String?
  email                  String          @unique
  password               String
  emailVerified          DateTime?
  image                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  stripeCurrentPeriodEnd DateTime?
  stripeCustomerId       String?         @unique
  stripePriceId          String?
  stripeSubscriptionId   String?         @unique
  subscriptionStatus     String?         @default("FREE")
  usageCount             Int             @default(0)
  quotes_with_savings    Int             @default(0)
  total_savings          Float?
  bio                    String?
  role                   String          @default("USER")
  socialLinks            Json?
  accounts               Account[]
  blogPosts              BlogPost[]
  comments               Comment[]
  quotes                 Quote[]
  sessions               Session[]
  uploadSessions         UploadSession[]
  Usage                  Usage[]
  xeroConnections        XeroConnection[]
  xeroImportSessions     XeroImportSession[]
  ownedOrganizations     Organization[]      @relation("OrganizationOwner")
  organizationMembers    OrganizationMember[]
  invitesSent            OrganizationInvite[] @relation("InvitesSent")
  approvalsRequested     QuoteApproval[]      @relation("ApprovalsRequested")
  approvalsDecided       QuoteApproval[]      @relation("ApprovalsDecided")
  rfqsCreated            Rfq[]
  auditLogs              AuditLog[]

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Quote {
  id               String            @id @default(cuid())
  userId           String
  title            String
  fileUrl          String
  status           String            @default("PENDING")
  originalData     Json?
  results          Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sourceType       String            @default("UPLOAD")
  organizationId   String?
  approvalStatus   String            @default("NONE") // NONE, PENDING, APPROVED, REJECTED
  fileStructures   FileStructure[]
  user             User              @relation(fields: [userId], references: [id])
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  xeroDocuments    XeroDocument[]
  approvals        QuoteApproval[]
  rfqs             Rfq[]
  priceObservations PriceObservation[]

  @@index([userId])
  @@index([organizationId])
}

model Rfq {
  id             String        @id @default(cuid())
  quoteId        String
  organizationId String?
  createdById    String
  title          String
  message        String?
  status         String        @default("DRAFT") // DRAFT, SENT, CLOSED
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  quote          Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdBy      User          @relation(fields: [createdById], references: [id])
  lineItems      RfqLineItem[]
  suppliers      RfqSupplier[]

  @@index([quoteId])
  @@index([organizationId])
}

model RfqLineItem {
  id          String @id @default(cuid())
  rfqId       String
  description String
  quantity    Float
  unitPrice   Float
  rfq         Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

model RfqSupplier {
  id          String    @id @default(cuid())
  rfqId       String
  name        String
  email       String
  status      String    @default("PENDING") // PENDING, SENT, RESPONDED, DECLINED
  token       String    @unique
  quotedTotal Float?
  notes       String?
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  rfq         Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  priceObservations PriceObservation[]

  @@index([rfqId])
}

model PriceObservation {
  id                     String   @id @default(cuid())
  description            String
  quantity               Float
  currency               String
  quotedUnitPrice        Float
  marketUnitPriceEstimate Float?
  source                 String   // QUOTE_ANALYSIS, RFQ_SUPPLIER_RESPONSE
  quoteId                String?
  organizationId         String?
  rfqSupplierId          String?
  createdAt              DateTime @default(now())

  quote        Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  rfqSupplier  RfqSupplier?  @relation(fields: [rfqSupplierId], references: [id], onDelete: SetNull)

  @@index([description])
  @@index([quoteId])
  @@index([organizationId])
  @@index([rfqSupplierId])
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  ownerId   String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  owner     User                 @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members   OrganizationMember[]
  invites   OrganizationInvite[]
  quotes    Quote[]
  approvals QuoteApproval[]
  rfqs      Rfq[]
  priceObservations PriceObservation[]
  auditLogs AuditLog[]

  @@index([ownerId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER") // OWNER, ADMIN, APPROVER, MEMBER
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String       @default("MEMBER") // ADMIN, APPROVER, MEMBER
  token          String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("InvitesSent", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@index([email])
}

model QuoteApproval {
  id             String       @id @default(cuid())
  quoteId        String
  organizationId String
  requestedById  String
  approverId     String?
  status         String       @default("PENDING") // PENDING, APPROVED, REJECTED
  note           String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())
  quote          Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User         @relation("ApprovalsRequested", fields: [requestedById], references: [id])
  approver       User?        @relation("ApprovalsDecided", fields: [approverId], references: [id])

  @@index([quoteId])
  @@index([organizationId])
}

model SubscriptionPlan {
  id            String   @id
  name          String
  description   String
  stripePriceId String   @unique
  features      Json
  price         Float
  interval      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model Usage {
  id             String   @id
  userId         String
  quotesAnalyzed Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  User           User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model UploadSession {
  id             String          @id @default(cuid())
  userId         String
  type           String
  status         String          @default("PROCESSING")
  totalFiles     Int
  processedFiles Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  fileStructures FileStructure[]
  user           User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model FileStructure {
  id           String        @id @default(cuid())
  sessionId    String
  originalPath String
  fileName     String
  quoteId      String
  parentFolder String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  quote        Quote         @relation(fields: [quoteId], references: [id])
  session      UploadSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([quoteId])
}

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String?
  content     String
  image       String?
  published   Boolean    @default(false)
  featured    Boolean    @default(false)
  authorId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  views       Int        @default(0)
  readingTime Int?
  author      User       @relation(fields: [authorId], references: [id])
  comments    Comment[]
  categories  Category[] @relation("BlogPostToCategory")
  tags        Tag[]      @relation("BlogPostToTag")

  @@index([authorId])
  @@index([slug])
  @@index([published])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[] @relation("BlogPostToCategory")
}

model Tag {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  posts     BlogPost[] @relation("BlogPostToTag")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  postId    String
  authorId  String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  author    User      @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  post      BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
}

model XeroConnection {
  id                String             @id @default(cuid())
  userId            String
  tenantId          String             // Xero organization identifier
  tenantName        String
  accessToken       String             @db.Text
  refreshToken      String             @db.Text
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  xeroDocuments     XeroDocument[]
  importSessions    XeroImportSession[]

  @@unique([userId, tenantId])
  @@index([userId])
}

model XeroDocument {
  id                String          @id @default(cuid())
  connectionId      String
  xeroId            String          // Original Xero document ID
  documentType      String          // QUOTE, INVOICE, RECEIPT, etc.
  documentNumber    String
  documentDate      DateTime
  contactName       String
  contactId         String
  status            String
  total             Float
  currencyCode      String
  quoteId           String?
  fileUrl           String?
  originalData      Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  connection        XeroConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  quote             Quote?          @relation(fields: [quoteId], references: [id])

  @@unique([connectionId, xeroId])
  @@index([connectionId])
  @@index([quoteId])
}

model XeroImportSession {
  id                  String          @id @default(cuid())
  userId              String
  connectionId        String
  status              String          @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  totalDocuments      Int
  processedDocuments  Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection          XeroConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([connectionId])
}
