generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String    @unique
  password               String
  emailVerified          DateTime?
  image                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  stripeCurrentPeriodEnd DateTime?
  stripeCustomerId       String?   @unique
  stripePriceId          String?
  stripeSubscriptionId   String?   @unique
  subscriptionStatus     String?   @default("FREE")
  usageCount             Int       @default(0)
  total_savings          Float?
  quotes_with_savings    Int       @default(0)
  accounts               Account[]
  quotes                 Quote[]
  sessions               Session[]
  Usage                  Usage[]
  uploadSessions         UploadSession[]

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Quote {
  id           String   @id @default(cuid())
  userId       String
  title        String
  fileUrl      String
  status       String   @default("PENDING")
  originalData Json?
  results      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
  fileStructures FileStructure[]

  @@index([userId])
}

model SubscriptionPlan {
  id            String   @id
  name          String
  description   String
  stripePriceId String   @unique
  features      Json
  price         Float
  interval      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model Usage {
  id             String   @id
  userId         String
  quotesAnalyzed Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  User           User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model UploadSession {
  id            String    @id @default(cuid())
  userId        String
  type          String    // 'MULTIPLE', 'ZIP', 'FOLDER'
  status        String    @default("PROCESSING")
  totalFiles    Int
  processedFiles Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  fileStructures FileStructure[]
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model FileStructure {
  id            String    @id @default(cuid())
  sessionId     String
  originalPath  String    // Original folder structure path
  fileName      String
  quoteId       String    // Reference to Quote
  parentFolder  String?   // For folder hierarchy
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  session       UploadSession @relation(fields: [sessionId], references: [id])
  quote         Quote     @relation(fields: [quoteId], references: [id])

  @@index([sessionId])
  @@index([quoteId])
}
